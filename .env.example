# PostgreSQL数据库连接配置
PGHOST=postgres
PGDATABASE=fishery_map
PGUSER=your_user
PGPASSWORD=your_password
ENDPOINT_ID=your_endpoint_id

# HiFleet Cookie用于数据抓取
HIFLEET_COOKIE=your_cookie_here

# 瓦片文件本地路径 (宿主机路径)
NAVIONICS_DICT_HOST=/path/to/tiles

# 域名配置 (Traefik使用)
DOMAIN=fishery.example.com