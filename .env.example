# PostgreSQL数据库连接配置
PGHOST=postgres
PGDATABASE=fishery_map
PGUSER=your_user
PGPASSWORD=your_password
ENDPOINT_ID=your_endpoint_id

# HiFleet Cookie用于数据抓取
HIFLEET_COOKIE=your_cookie_here

# 瓦片文件本地路径 (宿主机路径)
NAVIONICS_DICT_HOST=/path/to/tiles

# 域名配置 (Traefik使用)
DOMAIN=fishery.example.com

# Traefik BasicAuth（整站保护）
# 生成方式：
# - 使用 htpasswd（推荐）： htpasswd -nb your_user your_password
# - 无 htpasswd 时： echo "your_user:$(openssl passwd -apr1 'your_password')"
# 将生成的 "user:hash" 赋值给下方变量，支持多个用户以逗号分隔
TRAEFIK_BASIC_AUTH_USERS=user:$apr1$example$abcdefghijklmnopqrstuv
